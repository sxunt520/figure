# Mobile: use the computer's LAN IP when running on a real phone.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000/v1

# API
PORT=3000
DEVICE_ONLINE_WINDOW_SECONDS=45
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=figure_companion
# Development only. Use migrations and set this to false in production.
DB_SYNCHRONIZE=true

# Reserved for the Alibaba Cloud voice adapter implemented in the next stage.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_NLS_APP_KEY=
